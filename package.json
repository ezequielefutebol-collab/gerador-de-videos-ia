{
  "name": "gerador-de-videos-ia",
  "version": "1.0.0",
  "description": "Sistema automatizado de criação de vídeos para Instagram Reels e TikTok",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "generate": "tsx cli/index.ts",
    "render:motivacional": "remotion render --browser-executable /opt/pw-browsers/chromium-1243/chrome-linux64/chrome MotivationalReel output/motivacional.mp4",
    "render:cinematografico": "remotion render --browser-executable /opt/pw-browsers/chromium-1243/chrome-linux64/chrome CinematicReel output/cinematografico.mp4",
    "render:minimalista": "remotion render --browser-executable /opt/pw-browsers/chromium-1243/chrome-linux64/chrome MinimalistReel output/minimalista.mp4",
    "render:energia": "remotion render --browser-executable /opt/pw-browsers/chromium-1243/chrome-linux64/chrome EnergyReel output/energia.mp4",
    "render:car": "remotion render --browser-executable /opt/pw-browsers/chromium-1243/chrome-linux64/chrome CarCinematic output/car_cinematic.mp4",
    "render:predio": "remotion render --browser-executable /opt/pw-browsers/chromium-1243/chrome-linux64/chrome PredioAnimation output/predio_animation.mp4",
    "typecheck": "tsc --noEmit"
  },
  "remotion": {
    "entryPoint": "./src/index.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.279",
    "@remotion/cli": "4.0.279",
    "@remotion/renderer": "4.0.279",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.279"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
